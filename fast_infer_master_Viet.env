# Master config cho benchmark tóm tắt tiếng Việt trên B200.
#
# Cách dùng trên server:
#   1. Sao chép file này tới:
#      /workspace/storage-shared/nlp/dungdx4/phuc_projects/data/fast_infer_master_Viet.env
#   2. Sửa MODEL_ROOT và các MODEL_*_DRAFT nếu checkpoint thực tế nằm ở thư mục khác.
#   3. Chạy từ root repo:
#      bash scripts/run.sh longbench_200
#
# Đây là shell-env được source bằng bash, không phải file dotenv thuần. Không
# ghi HF_TOKEN thật vào file hoặc commit token vào git; export token bên ngoài
# khi baseline cần model gated.

# ---------------------------------------------------------------------------
# Runtime / offline server
# ---------------------------------------------------------------------------

# Production B200 dùng Python 3.12 hệ thống. Gán rõ biến này để một
# virtualenv developer đang activate không bị child benchmark kế thừa nhầm.
FI_PYTHON="${FI_PYTHON:-python3}"
FI_DEVICE="${FI_DEVICE:-cuda}"

# Rỗng = dùng toàn bộ GPU đang nhìn thấy. Đặt ví dụ 0,1,2,3 để giới hạn pool.
# Có thể override riêng bằng --gpu-ids của scripts/run_longbench_200.py.
FI_GPU_IDS="${FI_GPU_IDS:-}"
FI_TARGET_GPU="${FI_TARGET_GPU:-B200}"
B200_MIN_COMPUTE_MAJOR="${B200_MIN_COMPUTE_MAJOR:-10}"
B200_MIN_FREE_GB="${B200_MIN_FREE_GB:-32}"

# Server không có internet; tất cả model/dataset/wheel phải có sẵn local.
FI_OFFLINE="${FI_OFFLINE:-1}"
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
HF_TOKEN="${HF_TOKEN:-}"
FI_LOCAL_FILES_ONLY="${FI_LOCAL_FILES_ONLY:-1}"

# Cache model giữ ở HOME; cache extension để /tmp vì runtime cần nơi ghi được.
FI_HF_HOME="${FI_HF_HOME:-$HOME/.cache/huggingface}"
FI_TRANSFORMERS_CACHE="${FI_TRANSFORMERS_CACHE:-$FI_HF_HOME/hub}"
FAST_INFER_CACHE_ROOT="${FAST_INFER_CACHE_ROOT:-/tmp/fast_infer_cache}"
FI_TRITON_CACHE="${FI_TRITON_CACHE:-$FAST_INFER_CACHE_ROOT/triton}"
FI_FLASHINFER_CACHE="${FI_FLASHINFER_CACHE:-$FAST_INFER_CACHE_ROOT/flashinfer}"
FI_TORCH_EXTENSIONS_CACHE="${FI_TORCH_EXTENSIONS_CACHE:-$FAST_INFER_CACHE_ROOT/torch_extensions}"

# ---------------------------------------------------------------------------
# Model/checkpoint paths — operator block
# ---------------------------------------------------------------------------

# Đổi MODEL_ROOT nếu server mount model ở vị trí khác. Các đường dẫn draft bên
# dưới tương ứng với checkpoint upstream thường dùng:
#   EAGLE3  = AngelSlim/Qwen3-4B_eagle3
#   DFlash  = z-lab/Qwen3-4B-DFlash-b16
#   Domino  = Huang2020/Qwen3-4B-Domino-b16
# DSpark thường là export/checkpoint nội bộ từ SpecForge nên cần sửa đường dẫn
# nếu tên snapshot trên server khác mặc định bên dưới.
MODEL_ROOT="${MODEL_ROOT:-/workspace/storage-shared/models}"
MODEL_TARGET="${MODEL_TARGET:-$MODEL_ROOT/Qwen3-4B}"
MODEL_EAGLE_DRAFT="${MODEL_EAGLE_DRAFT:-$MODEL_ROOT/Qwen3-4B_eagle3}"
MODEL_DFLASH_DRAFT="${MODEL_DFLASH_DRAFT:-$MODEL_ROOT/Qwen3-4B-DFlash-b16}"
MODEL_DOMINO_DRAFT="${MODEL_DOMINO_DRAFT:-$MODEL_ROOT/Qwen3-4B-Domino-b16}"
MODEL_DSPARK_DRAFT="${MODEL_DSPARK_DRAFT:-$MODEL_ROOT/Qwen3-4B-DSpark}"

# Các alias tương thích với preflight/helper cũ. Không cần sửa riêng nếu các
# MODEL_* ở trên đã đúng.
B200_TARGET_MODEL="${B200_TARGET_MODEL:-$MODEL_TARGET}"
B200_EAGLE_MODEL="${B200_EAGLE_MODEL:-$MODEL_EAGLE_DRAFT}"
B200_DFLASH_MODEL="${B200_DFLASH_MODEL:-$MODEL_DFLASH_DRAFT}"
B200_DOMINO_MODEL="${B200_DOMINO_MODEL:-$MODEL_DOMINO_DRAFT}"
B200_DSPARK_MODEL="${B200_DSPARK_MODEL:-$MODEL_DSPARK_DRAFT}"

# Một số helper legacy có thể đọc các tên này; để trống nếu không chạy chúng.
MODEL_SPEC_DRAFT="${MODEL_SPEC_DRAFT:-}"
MODEL_LONGSPEC_TARGET="${MODEL_LONGSPEC_TARGET:-$MODEL_TARGET}"
MODEL_LONGSPEC_DRAFT="${MODEL_LONGSPEC_DRAFT:-}"
MODEL_COMPRESSOR="${MODEL_COMPRESSOR:-}"
MODEL_EMBEDDING="${MODEL_EMBEDDING:-}"

# ---------------------------------------------------------------------------
# LongBench-Viet matrix: 4 datasets x 6 baselines
# ---------------------------------------------------------------------------

LONG_BENCH_DATA_DIR="${LONG_BENCH_DATA_DIR:-datasets/eval_100}"
LONG_BENCH_OUTPUT_DIR="${LONG_BENCH_OUTPUT_DIR:-outputs/longbench_viet_100}"
LONG_BENCH_MODEL="${LONG_BENCH_MODEL:-$MODEL_TARGET}"
LONG_BENCH_DEVICE="${LONG_BENCH_DEVICE:-$FI_DEVICE}"
LONG_BENCH_GPU_IDS="${LONG_BENCH_GPU_IDS:-$FI_GPU_IDS}"
LONG_BENCH_DTYPE="${LONG_BENCH_DTYPE:-bfloat16}"
LONG_BENCH_BASELINES="${LONG_BENCH_BASELINES:-vanilla_hf vanilla_fa eagle3 dflash domino dspark}"
LONG_BENCH_REFERENCE_BASELINE="${LONG_BENCH_REFERENCE_BASELINE:-vanilla_fa}"
LONG_BENCH_DATASETS="${LONG_BENCH_DATASETS:-vietnews wikilingua vims vlsp}"
LONG_BENCH_REPRESENTATIVE_DATASETS="${LONG_BENCH_REPRESENTATIVE_DATASETS:-vietnews wikilingua vims vlsp}"

# Mặc định an toàn để smoke chạy nhanh; full dùng 100 mẫu/bộ.
LONG_BENCH_MODE="${LONG_BENCH_MODE:-smoke}"
LONG_BENCH_SMOKE_SAMPLES="${LONG_BENCH_SMOKE_SAMPLES:-1}"
LONG_BENCH_REPRESENTATIVE_SAMPLES="${LONG_BENCH_REPRESENTATIVE_SAMPLES:-20}"
LONG_BENCH_FULL_SAMPLES="${LONG_BENCH_FULL_SAMPLES:-100}"
LONG_BENCH_MAX_INPUT_TOKENS="${LONG_BENCH_MAX_INPUT_TOKENS:-0}"
LONG_BENCH_SMOKE_MAX_INPUT_TOKENS="${LONG_BENCH_SMOKE_MAX_INPUT_TOKENS:-4096}"
LONG_BENCH_MAX_NEW_TOKENS="${LONG_BENCH_MAX_NEW_TOKENS:-2048}"
LONG_BENCH_SMOKE_MAX_NEW_TOKENS="${LONG_BENCH_SMOKE_MAX_NEW_TOKENS:-8}"
LONG_BENCH_TEMPERATURE="${LONG_BENCH_TEMPERATURE:-0}"
LONG_BENCH_SEED="${LONG_BENCH_SEED:-42}"
LONG_BENCH_WARMUP_RUNS="${LONG_BENCH_WARMUP_RUNS:-3}"

# auto để adapter chọn batch/request concurrency theo độ dài và VRAM B200.
LONG_BENCH_BATCH_SIZE="${LONG_BENCH_BATCH_SIZE:-auto}"
LONG_BENCH_AUTO_BATCH_SIZE="${LONG_BENCH_AUTO_BATCH_SIZE:-8}"
LONG_BENCH_MAX_RUNNING_REQUESTS="${LONG_BENCH_MAX_RUNNING_REQUESTS:-auto}"
LONG_BENCH_TP_SIZE="${LONG_BENCH_TP_SIZE:-1}"
LONG_BENCH_MEM_FRACTION_STATIC="${LONG_BENCH_MEM_FRACTION_STATIC:-0.90}"
LONG_BENCH_SGLANG_ATTENTION_BACKEND="${LONG_BENCH_SGLANG_ATTENTION_BACKEND:-flashinfer}"
LONG_BENCH_SGLANG_PORT="${LONG_BENCH_SGLANG_PORT:-30000}"

# Checkpoint riêng cho từng baseline trong matrix.
LONG_BENCH_EAGLE_MODEL="${LONG_BENCH_EAGLE_MODEL:-$MODEL_EAGLE_DRAFT}"
LONG_BENCH_DFLASH_MODEL="${LONG_BENCH_DFLASH_MODEL:-$MODEL_DFLASH_DRAFT}"
LONG_BENCH_DOMINO_MODEL="${LONG_BENCH_DOMINO_MODEL:-$MODEL_DOMINO_DRAFT}"
LONG_BENCH_DSPARK_MODEL="${LONG_BENCH_DSPARK_MODEL:-$MODEL_DSPARK_DRAFT}"

# Timing/observability. Các record sample và aggregate vẫn được ghi đầy đủ;
# collector sẽ tạo metrics_summary.{json,csv,md} sau mỗi run.
LONG_BENCH_LOCAL_FILES_ONLY="${LONG_BENCH_LOCAL_FILES_ONLY:-1}"
LONG_BENCH_TIMEOUT_SECONDS="${LONG_BENCH_TIMEOUT_SECONDS:-900}"
LONG_BENCH_REPRESENTATIVE_TIMEOUT_SECONDS="${LONG_BENCH_REPRESENTATIVE_TIMEOUT_SECONDS:-3600}"
LONG_BENCH_FULL_TIMEOUT_SECONDS="${LONG_BENCH_FULL_TIMEOUT_SECONDS:-21600}"
LONG_BENCH_STRICT="${LONG_BENCH_STRICT:-1}"
LONG_BENCH_COLLECT="${LONG_BENCH_COLLECT:-1}"

# ---------------------------------------------------------------------------
# Multi-GPU data parallelism / VRAM planner
# ---------------------------------------------------------------------------

# Bật bằng --data-parallel hoặc đặt LONG_BENCH_DATA_PARALLEL=1. Mỗi shard
# mặc định giữ một GPU, phù hợp so sánh throughput và tránh oversubscription.
LONG_BENCH_DATA_PARALLEL="${LONG_BENCH_DATA_PARALLEL:-0}"
LONG_BENCH_DP_GPUS_PER_SHARD="${LONG_BENCH_DP_GPUS_PER_SHARD:-1}"
LONG_BENCH_DP_PROCESSES_PER_GPU="${LONG_BENCH_DP_PROCESSES_PER_GPU:-1}"
LONG_BENCH_VRAM_BUDGET_GB="${LONG_BENCH_VRAM_BUDGET_GB:-170}"
LONG_BENCH_VRAM_HEADROOM_GB="${LONG_BENCH_VRAM_HEADROOM_GB:-10}"
LONG_BENCH_CHILD_VRAM_GB="${LONG_BENCH_CHILD_VRAM_GB:-40}"
LONG_BENCH_VRAM_WAIT_SECONDS="${LONG_BENCH_VRAM_WAIT_SECONDS:-600}"
LONG_BENCH_OOM_RETRIES="${LONG_BENCH_OOM_RETRIES:-1}"
LONG_BENCH_SAMPLE_RETRIES="${LONG_BENCH_SAMPLE_RETRIES:-2}"
LONG_BENCH_RETRY_BACKOFF_SECONDS="${LONG_BENCH_RETRY_BACKOFF_SECONDS:-5}"
LONG_BENCH_RETRY_FAILED_SAMPLES="${LONG_BENCH_RETRY_FAILED_SAMPLES:-1}"
LONG_BENCH_CONTINUE_ON_ERROR="${LONG_BENCH_CONTINUE_ON_ERROR:-1}"

# ---------------------------------------------------------------------------
# Fallback defaults for standalone baseline launchers
# ---------------------------------------------------------------------------

RUN_MODE="${RUN_MODE:-smoke}"
RUN_SAMPLES="${RUN_SAMPLES:-5}"
RUN_MAX_NEW_TOKENS="${RUN_MAX_NEW_TOKENS:-2048}"
RUN_MAX_INPUT_TOKENS="${RUN_MAX_INPUT_TOKENS:-0}"
RUN_TEMPERATURE="${RUN_TEMPERATURE:-0}"
RUN_SKIP_NAIVE="${RUN_SKIP_NAIVE:-0}"
DATA_INPUT="${DATA_INPUT:-datasets/eval_100/vietnews_100.jsonl}"

DFLASH_DATA_FILE="${DFLASH_DATA_FILE:-$DATA_INPUT}"
DFLASH_BACKEND="${DFLASH_BACKEND:-transformers}"
DFLASH_BLOCK_SIZE="${DFLASH_BLOCK_SIZE:-4}"
EAGLE_DATA_FILE="${EAGLE_DATA_FILE:-$DATA_INPUT}"
EAGLE_BENCHMARK="${EAGLE_BENCHMARK:-vietnews}"
EAGLE_TOTAL_TOKENS="${EAGLE_TOTAL_TOKENS:-60}"
EAGLE_DEPTH="${EAGLE_DEPTH:-5}"
EAGLE_TOP_K="${EAGLE_TOP_K:-10}"

# Model names expected by a few upstream adapters. Qwen3 adapters should
# override these in their launcher if the upstream repository needs a label.
LONG_BENCH_LONGSPEC_MODEL_NAME="${LONG_BENCH_LONGSPEC_MODEL_NAME:-qwen3_4b}"
LONG_BENCH_SPECEXTEND_MODEL_NAME="${LONG_BENCH_SPECEXTEND_MODEL_NAME:-qwen3_4b}"

# ---------------------------------------------------------------------------
# DFlash preparation / OfflineSGLangCapture
# ---------------------------------------------------------------------------

# Shared venv for local simulation; production can override with python3.
FINETUNING_PYTHON="${FINETUNING_PYTHON:-${FAST_INFER_PYTHON:-python3}}"
FINETUNE_CAPTURE_BACKEND="${FINETUNE_CAPTURE_BACKEND:-hf}"
FINETUNE_CAPTURE_METHOD="${FINETUNE_CAPTURE_METHOD:-dflash}"
FINETUNE_CAPTURE_SGLANG_TP_SIZE="${FINETUNE_CAPTURE_SGLANG_TP_SIZE:-1}"
FINETUNE_CAPTURE_SGLANG_ATTENTION_BACKEND="${FINETUNE_CAPTURE_SGLANG_ATTENTION_BACKEND:-flashinfer}"
FINETUNE_CAPTURE_SGLANG_MEM_FRACTION_STATIC="${FINETUNE_CAPTURE_SGLANG_MEM_FRACTION_STATIC:-0.40}"
FINETUNE_CAPTURE_SGLANG_MAX_RUNNING_REQUESTS="${FINETUNE_CAPTURE_SGLANG_MAX_RUNNING_REQUESTS:-8}"
FINETUNE_CAPTURE_SGLANG_MAX_TOTAL_TOKENS="${FINETUNE_CAPTURE_SGLANG_MAX_TOTAL_TOKENS:-0}"
FINETUNE_CAPTURE_SGLANG_CONTEXT_LENGTH="${FINETUNE_CAPTURE_SGLANG_CONTEXT_LENGTH:-}"
FINETUNE_CAPTURE_SGLANG_DISABLE_RADIX_CACHE="${FINETUNE_CAPTURE_SGLANG_DISABLE_RADIX_CACHE:-0}"
FINETUNE_CAPTURE_PARITY_SAMPLES="${FINETUNE_CAPTURE_PARITY_SAMPLES:-2}"
FINETUNE_CAPTURE_PARITY_MAX_ABS_ERROR="${FINETUNE_CAPTURE_PARITY_MAX_ABS_ERROR:-0.05}"
FINETUNE_CAPTURE_PARITY_MEAN_ABS_ERROR="${FINETUNE_CAPTURE_PARITY_MEAN_ABS_ERROR:-0.01}"
FINETUNE_CAPTURE_PARITY_RELATIVE_L2_ERROR="${FINETUNE_CAPTURE_PARITY_RELATIVE_L2_ERROR:-0.05}"
FINETUNE_CAPTURE_PARITY_MIN_COSINE_SIMILARITY="${FINETUNE_CAPTURE_PARITY_MIN_COSINE_SIMILARITY:-0.999}"
